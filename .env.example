# Copy this to .env and fill in your bot token.
# Optional knobs are commented out — uncomment if you want to override defaults.

TELEGRAM_BOT_TOKEN=000000000:AA_____replace_with_your_token_____

# Display name (in Telegram) of the person who collects from everyone.
# Default: "Milad Momeni"
# BADMINTON_COLLECTOR=Your Name Here

# $ per court per hour. Default 25.
# BADMINTON_RATE=25

# Yes-vote cap per court. Default 6. Extras go on a waitlist.
# BADMINTON_MAX_PER_COURT=6
